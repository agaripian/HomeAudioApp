<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Custom SeekBar style for dark theme with better contrast -->
    <style name="CustomSeekBarStyle">
        <item name="android:progressBackgroundTint">@color/seekbar_track_color</item>
        <item name="android:progressTint">@color/seekbar_progress_color</item>
        <item name="android:thumbTint">@color/seekbar_thumb_color</item>
        <item name="android:minHeight">26dp</item>
        <item name="android:maxHeight">26dp</item>
    </style>
    
    <!-- Style for disabled SeekBar states in dark theme -->
    <style name="DisabledSeekBarStyle">
        <item name="android:progressBackgroundTint">@color/slider_track_dark_disabled</item>
        <item name="android:progressTint">@color/slider_progress_dark_disabled</item>
        <item name="android:thumbTint">@color/slider_thumb_dark_disabled</item>
        <item name="android:minHeight">26dp</item>
        <item name="android:maxHeight">26dp</item>
        <item name="android:enabled">false</item>
    </style>
</resources> 