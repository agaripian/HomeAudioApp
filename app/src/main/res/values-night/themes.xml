<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark application theme. -->
    <style name="Theme.HomeAudioGem" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Primary brand color - now using darker header -->
        <item name="colorPrimary">@color/header_color_dark</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/header_color_accent</item>
        
        <!-- Dark theme background colors -->
        <item name="android:colorBackground">@color/dark_background</item>
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="cardBackgroundColor">@color/dark_surface</item>
        <item name="colorSurface">@color/dark_surface</item>
        
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/dark_text_primary</item>
        <item name="android:textColorSecondary">@color/dark_text_secondary</item>
        
        <!-- Status bar handling -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources> 